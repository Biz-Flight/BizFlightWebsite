{
  "name": "bizflight-website",
  "version": "1.0.0",
  "private": true,
  "description": "BizFlight static company website using HTML, Tailwind CSS, and vanilla JavaScript.",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "preview": "python3 -m http.server 8000",
    "validate": "python3 scripts/validate.py"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0"
  }
}
